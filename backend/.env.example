# Database
DATABASE_URL=
DATABASE_URL_SYNC=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# Redis (for Celery)
REDIS_URL=redis://redis:6379/0

# App
SECRET_KEY=changeme
DEBUG=False

# Persistent YOLO inference worker
YOLO_MODEL_PATH=yolo/yolo11n.pt
YOLO_DEVICE=auto
YOLO_IMAGE_SIZE=512
CONFIDENCE_THRESHOLD=0.25
TRACK_FPS=5
YOLO_TRACKER=bytetrack.yaml
TRACK_FLOW_MIN_FRAMES=3
TRACK_FLOW_EXIT_FRAMES=5
TRACK_DB_FLUSH_SECONDS=60
STREAM_FPS=5
STREAM_JPEG_QUALITY=70

# CCTV scheduler
# Existing cameras default to the MEDIUM tier unless configured otherwise.
CAMERA_HIGH_INTERVAL_SECONDS=10
CAMERA_MEDIUM_INTERVAL_SECONDS=60
CAMERA_LOW_INTERVAL_SECONDS=60
CAMERA_SCHEDULER_TICK_SECONDS=1
CAMERA_SCHEDULER_MAX_DISPATCH_PER_TICK=8
CAMERA_RETRY_BASE_SECONDS=5
CAMERA_RETRY_MAX_SECONDS=60
CAMERA_FAILURES_BEFORE_OFFLINE=4

# Historical snapshot sampler (HISTORICAL cameras, one frame per cycle)
# Relaxed cadence after backfill. For the first ~24h boost to 180/300/600.
SNAPSHOT_HIGH_INTERVAL_SECONDS=900
SNAPSHOT_MEDIUM_INTERVAL_SECONDS=1800
SNAPSHOT_LOW_INTERVAL_SECONDS=3600
SNAPSHOT_CLAIM_BATCH_SIZE=12
SNAPSHOT_CHUNK_SIZE=10
SNAPSHOT_FAILURES_BEFORE_OFFLINE=5
SNAPSHOT_DRY_RUN=False

# Latest emission freshness
DATA_FRESH_THRESHOLD_SECONDS=30
DATA_AGING_THRESHOLD_SECONDS=90

# CCTV frame sampling
FRAME_CAPTURE_OPEN_TIMEOUT_SECONDS=10
FRAME_CAPTURE_READ_TIMEOUT_SECONDS=10
FRAME_FFMPEG_TIMEOUT_SECONDS=30

# Bounded inference queue and short-lived frame storage
INFERENCE_QUEUE_MAX_PENDING=64
INFERENCE_RESERVATION_TTL_SECONDS=180
INFERENCE_FRAME_TTL_SECONDS=180
INFERENCE_FRAME_MAX_BYTES=2000000
INFERENCE_JPEG_QUALITY=85
INFERENCE_TASK_SOFT_TIME_LIMIT_SECONDS=90
INFERENCE_TASK_TIME_LIMIT_SECONDS=120
INFERENCE_MAX_RETRIES=2
INFERENCE_MAX_BATCH_SIZE=8
INFERENCE_MAX_BATCH_WAIT_MS=200
INFERENCE_BATCH_RESULT_TIMEOUT_SECONDS=80
INFERENCE_WORKER_CONCURRENCY=8

# Temporal emission aggregation
EMISSION_AGGREGATION_WINDOW_SECONDS=60
# Completed flow windows and segment worker cadence share this setting.
# Keep 60s unless write/Redis/WebSocket load has been measured at 10s.
SEGMENT_OBSERVATION_WINDOW_SECONDS=60
SEGMENT_LATEST_STATE_TTL_SECONDS=3600

# Redis latest emission state (per camera)
LATEST_EMISSION_STATE_TTL_SECONDS=3600

# Mapid (optional for scrape activities data)
MAPID_API_URL=
MAPID_API_KEY_MISSION=

# Openrouter
OPENROUTER_API_KEY=
# Set true to log the full raw LLM response on parse failure (diagnostics).
BANGJO_DEBUG_RAW=false