# Copy to observability/.env, which is gitignored. Use the second --env-file flag.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
GRAFANA_PORT=3001
APP_ENV=production
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080
PUBLIC_WS_URL=ws://localhost:8080
# Public basemap style key. Copy this value from frontend/.env.
NEXT_PUBLIC_GEOMAPID_API_KEY=
BROWSER_SAMPLE_RATE=0.1
