# Database
DATABASE_URL=
DATABASE_URL_SYNC=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# Redis (for Celery)
REDIS_URL=

# App
SECRET_KEY=changeme
DEBUG=true

# YOLO
YOLO_MODEL_PATH=yolov8n.pt
CONFIDENCE_THRESHOLD=0.4

# CCTV scheduler
CAMERA_HIGH_INTERVAL_SECONDS=10
CAMERA_MEDIUM_INTERVAL_SECONDS=60
CAMERA_LOW_INTERVAL_SECONDS=60
CAMERA_SCHEDULER_TICK_SECONDS=1
CAMERA_SCHEDULER_MAX_DISPATCH_PER_TICK=8

# CCTV frame sampling
FRAME_CAPTURE_OPEN_TIMEOUT_SECONDS=10
FRAME_CAPTURE_READ_TIMEOUT_SECONDS=10
FRAME_FFMPEG_TIMEOUT_SECONDS=30

# Bounded inference queue and short-lived frame storage
INFERENCE_QUEUE_MAX_PENDING=64
INFERENCE_RESERVATION_TTL_SECONDS=180
INFERENCE_FRAME_TTL_SECONDS=180
INFERENCE_FRAME_MAX_BYTES=2000000
INFERENCE_JPEG_QUALITY=85
INFERENCE_TASK_SOFT_TIME_LIMIT_SECONDS=90
INFERENCE_TASK_TIME_LIMIT_SECONDS=120
INFERENCE_MAX_RETRIES=2
